# Solo Empire Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Runtime secret provider
# auto = Infisical (if configured), then Vault (if configured), then env.
SECRETS_PROVIDER=auto
# Set true only when an explicit provider may fall back to local env values.
SECRETS_FALLBACK_ENV=false

# Infisical Universal Auth/API (bootstrap only; secret values stay in Infisical)
# INFISICAL_SITE_URL=https://app.infisical.com
# INFISICAL_PROJECT_ID=d0d84520-c3d0-48da-980c-a987c3077122
# INFISICAL_ENVIRONMENT=dev
# INFISICAL_SECRET_PATH=/google
# INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=...
# INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=...
# Or use a logged-in Infisical CLI session:
# INFISICAL_CLI_ENABLED=true

# Hosted HashiCorp Vault alternative (KV v2 + token or AppRole)
# Not Vaultwarden. Requires a real VAULT_ADDR from your operator/HCP project.
# SECRETS_PROVIDER=vault
# VAULT_ADDR=https://<your-hosted-vault-hostname>
# VAULT_KV_MOUNT=secret
# VAULT_SECRET_PATH=solo-empire/google
# VAULT_NAMESPACE=          # set only if your cluster uses namespaces
# VAULT_TOKEN=...           # short-lived token OR use AppRole below
# VAULT_ROLE_ID=...
# VAULT_SECRET_ID=...
# VAULT_AUTH_MOUNT=approle
# Keys expected at KV path solo-empire/google:
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN

# Google OAuth (used by weekly_review, daily_briefing, sync scripts)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Google OAuth (alternate — used by get_google_refresh_token.py utility)
GOOGLE_CLIENT_ID_ALT=your-alt-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_ALT=your-alt-google-client-secret

# Matrix sync target resource IDs (non-secret configuration; keep the mapping
# target disabled until the owning workspace has an approved sync destination).
# MATRIX_GOOGLE_SHEETS_RESOURCE_ID=<spreadsheet-id>
# MATRIX_EXCEL_RESOURCE_ID=<workbook-drive-item-id>
# MATRIX_NOTION_DATABASE_ID=<notion-database-id>

# Cloudflare
CLOUDFLARE_API_TOKEN=

# Hosted data-lake target (R2 + Iceberg REST catalog; opt-in only)
# Keep these in the secret provider or ignored local env, never in Git.
# SOLO_EMPIRE_DATA_LAKE_URI=s3://solo-empire-portfolio
# DATA_LAKE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ICEBERG_CATALOG_URI=https://<r2-data-catalog-uri>
# ICEBERG_WAREHOUSE_URI=<provider-issued-warehouse-name>
# ICEBERG_CATALOG_TOKEN=<scoped-r2-data-catalog-token>
# DATA_LAKE_CLOUD_WRITE_ENABLED=false
# DATA_LAKE_CLOUD_MAX_OBJECT_BYTES=67108864

# Optional hosted data-platform integrations (see systems/hosted-data-integrations.md)
# BigQuery: use local ADC or GitHub OIDC; never commit a service-account JSON file.
# GOOGLE_CLOUD_PROJECT=<gcp-project-id>
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/adc.json
# GCP_PROJECT_ID=<gcp-project-id>
# GCP_WORKLOAD_IDENTITY_PROVIDER=<github-oidc-provider-resource>
# GCP_SERVICE_ACCOUNT=<github-actions-service-account>
# Optional Neon control/catalog database (separate from trading database).
# NEON_DATA_LAKE_CATALOG_URL=postgresql+psycopg2://<user>:<password>@<host>/<db>?sslmode=require
# Prefect Cloud (choose it OR GitHub scheduling per job).
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account>/workspaces/<workspace>
# PREFECT_API_KEY=<prefect-api-key>
# Grafana Cloud OTLP (telemetry only; never payload data).
# GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# GRAFANA_CLOUD_API_KEY=<grafana-cloud-api-key>

# Generalist cloud lanes (see systems/cloud-generalist-stack.md)
# Cloudflare Pages/Workers: use the same scoped Cloudflare token, plus a project name for Pages.
# CLOUDFLARE_PAGES_PROJECT=<pages-project-name>
# Cloudflare Turnstile (public sitekey + server-side secret).
# TURNSTILE_SITE_KEY=<turnstile-sitekey>
# TURNSTILE_SECRET_KEY=<turnstile-secret-key>
# Optional Vercel Hobby frontend comparison.
# VERCEL_PROJECT_ID=<vercel-project-id>
# Optional Supabase Auth/Realtime/BaaS comparison (not lake storage).
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=<supabase-anon-key>
# Optional Google Cloud Run container backend comparison. Set billing alerts first.
# CLOUD_RUN_SERVICE=<cloud-run-service-name>
# Optional Upstash Redis cache/rate-limit/queue lab.
# UPSTASH_REDIS_REST_URL=https://<database>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>
# Optional Resend transactional email.
# RESEND_API_KEY=<resend-api-key>
# Stripe payments (server-side only; start with test/sandbox keys).
# STRIPE_SECRET_KEY=<stripe-secret-key>
# STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>
# Optional PostHog read-only product analytics. Use the private API host for
# your region (https://us.posthog.com or https://eu.posthog.com).
# POSTHOG_HOST=https://us.posthog.com
# POSTHOG_API_KEY=
# POSTHOG_PROJECT_ID=<posthog-project-id>
# Optional Sentry read-only observability. Use a token scoped to org/project read access.
# SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project-id>
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG_SLUG=<sentry-org-slug>
# SENTRY_BASE_URL=https://sentry.io
# Optional Slack read-only workspace metadata. Requires a bot token with channels:read.
# SLACK_BOT_TOKEN=<slack-bot-token>
# Optional Notion read-only page/data-source inventory. The token is resolved
# from the /notion secret folder; the API version defaults to the latest pinned version.
# NOTION_BOT_TOKEN=<notion-bot-token>
# NOTION_VERSION=2026-03-11
# Optional Asana read-only workspace/project metadata. Use a PAT with the
# smallest required scopes (`workspaces:read`, and `projects:read` for projects).
# ASANA_PERSONAL_ACCESS_TOKEN=<asana-personal-access-token>
# Optional Linear read-only team/project metadata. Personal API keys are sent
# in the Authorization header and must stay in the /linear secret folder.
# LINEAR_API_KEY=<linear-api-key>
# Optional Discord read-only bot identity and guild metadata.
# DISCORD_BOT_TOKEN=<discord-bot-token>
# Optional WhatsApp Business Cloud API read-only WABA phone metadata.
# WHATSAPP_CLOUD_API_TOKEN=<whatsapp-cloud-api-token>
# WHATSAPP_BUSINESS_ACCOUNT_ID=<waba-id>
# WHATSAPP_GRAPH_API_VERSION=v25.0
# Optional Microsoft Graph delegated read-only signed-in-user metadata.
# MICROSOFT_GRAPH_ACCESS_TOKEN=<microsoft-graph-access-token>
# Optional Zoom authenticated-user read-only profile metadata.
# ZOOM_ACCESS_TOKEN=<zoom-access-token>
# Optional monday.com read-only board metadata.
# MONDAY_API_TOKEN=<monday-api-token>
# Infisical Cloud/self-hosted secret source (already supported by this repo).
# INFISICAL_SITE_URL=https://app.infisical.com
# INFISICAL_PROJECT_ID=<infisical-project-id>
# INFISICAL_ENVIRONMENT=dev
# INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=<machine-identity-client-id>
# INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=<machine-identity-client-secret>

# Optional free-stock image APIs. Openverse works with no key.
# PEXELS_API_KEY=<pexels-api-key>
# UNSPLASH_ACCESS_KEY=<unsplash-access-key>

# Firecrawl
FIRECRAWL_API_KEY=your-firecrawl-api-key

# Trading bot database (Neon Postgres)
TRADING_DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# API server authentication. Production accepts either a strong legacy token
# or the preferred hash-only scoped registry below.
API_TOKEN=your-api-bearer-token
# Preferred least-privilege registry. Store SHA-256 hashes only; never put raw
# bearer tokens in this JSON. Example:
# API_TOKENS_JSON=[{"subject":"bookfinance-dashboard","token_hash":"<64-hex-sha256>","scopes":["finance:read"],"expires_at":"2026-12-31T23:59:59Z"}]
# Generate one hash with a hidden prompt (the raw token is not printed):
# task auth:hash-token

# Local Finance API edge guard (use a distributed gateway before high volume)
# FINANCE_API_RATE_LIMIT=60
# FINANCE_API_RATE_WINDOW_MS=60000
# FINANCE_API_RATE_LIMIT_ENABLED=true

# Allow unauthenticated writes in development (set to true only for local dev)
# WARNING: This allows anyone with network access to modify your database
ALLOW_UNAUTH_DEV=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Dashboard API CORS allowed origins (comma-separated)
DASHBOARD_CORS_ORIGINS=http://localhost:3000,http://localhost:3456

# Optional BA / SA Architecture Catalog provider adapters. The dashboard uses
# the local repository registry by default. When set, these URLs are read with
# bounded GET requests only; no provider write or credential is stored here.
# Backstage URL should point to the catalog API base, commonly /api/catalog.
# ARCHITECTURE_BACKSTAGE_CATALOG_URL=http://127.0.0.1:7007/api/catalog
# OpenMetadata URL should point to the API base, commonly /api.
# ARCHITECTURE_OPENMETADATA_API_URL=http://127.0.0.1:8585/api
# Optional: inject a least-privilege OpenMetadata bot/PAT at runtime only.
# Never commit or place the token in this file; the adapter sends it server-side
# as a Bearer header for the bounded read-only table projection.
# ARCHITECTURE_OPENMETADATA_API_TOKEN=

# Local Frappe CRM + ERPNext read-only dashboard adapter. By default the
# adapter uses the local Frappe stack at 127.0.0.1:8090 and the ignored
# credentials files under infra/self-hosted-stack/frappe/.runtime/. The client
# automatically prefers dashboard-reader.env when this variable is unset.
FRAPPE_ENABLED=true
FRAPPE_BASE_URL=http://127.0.0.1:8090
FRAPPE_SITE_NAME=solo-empire.localhost
# FRAPPE_CREDENTIALS_FILE=infra/self-hosted-stack/frappe/.runtime/dashboard-reader.env
FRAPPE_TIMEOUT_MS=5000
FRAPPE_MAX_ROWS=10
# Prefer the generated local reader with:
# task integrations:frappe:dashboard-reader -- --apply
# Never commit token values. Administrator credentials remain a local fallback
# only when the reader token has not been provisioned.
# FRAPPE_API_KEY=<read-only-api-key>
# FRAPPE_API_SECRET=<read-only-api-secret>

# Maximum request body size in bytes (default: 1MB)
MAX_BODY_SIZE=1048576

# AI service lanes
# - subscription: human interactive work (manual client; never called by the API)
# - api: applications and agents through the Central AI Gateway
# - runpod: on-demand GPU worker for batch/multimodal workloads
# The subscription amount is a fixed monthly commitment in the shared USD cap;
# it is metadata only and does not attempt to inspect or cancel a provider plan.
# AI_SUBSCRIPTION_MONTHLY_USD=0
# AI_STORAGE_MONTHLY_USD=0
# Central AI Gateway (opt-in; provider credentials must come from Infisical/Vault)
# The adapter uses an OpenAI-compatible `/chat/completions` endpoint, so it
# works with hosted providers AND local/self-hosted OpenAI-compatible servers
# (Ollama, llama.cpp server, vLLM). Keep any real key out of Git.
#
# Option A — hosted provider (costs money per token):
# AI_GATEWAY_PROVIDER=openai-compatible
# AI_GATEWAY_PROVIDER_NAME=openai
# AI_GATEWAY_BASE_URL=https://api.openai.com/v1
# AI_GATEWAY_API_KEY=<provider-key>
# AI_GATEWAY_MODEL=gpt-5.6-luna
# AI_GATEWAY_MODEL_FAST=gpt-5.6-luna
# AI_GATEWAY_MODEL_BALANCED=gpt-5.6-luna
# AI_GATEWAY_MODEL_QUALITY=gpt-5.6-luna
# A configured adapter must declare the current rate card. Use 0 for a measured
# local/free lane; unknown or missing prices fail closed before provider calls.
# AI_GATEWAY_INPUT_USD_PER_1K=0.0002
# AI_GATEWAY_OUTPUT_USD_PER_1K=0.0012
# Process-local pilot abuse guard (keyed by authenticated subject; no IP trust).
# AI_GATEWAY_MAX_REQUESTS_PER_MINUTE=30
# AI_GATEWAY_MAX_CONCURRENT_REQUESTS=2
# Optional per-subject overrides, e.g. {"ev3-web":{"max_requests_per_minute":120,"max_concurrent_requests":8}}
# AI_GATEWAY_SUBJECT_LIMITS_JSON=
# Newer OpenAI models: send max_completion_tokens and omit temperature.
# AI_GATEWAY_TOKEN_PARAM=max_tokens            # or max_completion_tokens
# AI_GATEWAY_SEND_TEMPERATURE=true             # false for models that reject it
# AI_GATEWAY_REASONING_EFFORT=                 # optional, e.g. low
# Per-request token_budget ceiling (defaults to AI_GATEWAY_DEFAULT_TOKEN_BUDGET).
# AI_GATEWAY_MAX_TOKEN_BUDGET=
# One fallback attempt on 429/5xx/timeout/network error (optional).
# AI_GATEWAY_FALLBACK_MODEL=
# AI_GATEWAY_FALLBACK_MODEL_FAST=
# AI_GATEWAY_FALLBACK_INPUT_USD_PER_1K=        # defaults to the primary rate card
# AI_GATEWAY_FALLBACK_OUTPUT_USD_PER_1K=
# unknown (default) records NULL cost for provider errors; bounded records 0
# for HTTP rejections and the reserved estimate for timeouts.
# AI_GATEWAY_ERROR_COST_POLICY=unknown
# Hosted standalone gateway only (infra/api/ai-gateway-service; see
# operations/runbooks/AI-API-GATEWAY-RUNBOOK.md "Hosted service (Railway)"):
# AI_GATEWAY_DB_PATH=/data/ai-gateway.sqlite
# AI_GATEWAY_MONTHLY_BUDGET_USD=<hosted-cap>
# AI_GATEWAY_REQUIRE_BUDGET=true
# AI_GATEWAY_MAX_BODY_BYTES=1048576
#
# Option B — local Ollama on your own GPU (free; see
# operations/runbooks/LOCAL-LLM-OLLAMA-RUNBOOK.md for setup). No API key
# needed for loopback in non-production — the gateway allows plain HTTP only
# for localhost/127.0.0.1/::1 and only when NODE_ENV != production.
# Two models pulled and measured on an RTX 3050 6GB (2026-08-13): route fast/
# balanced to the small one, quality to the bigger one — the gateway already
# supports this per-profile, it just had nothing behind any profile before.
# AI_GATEWAY_PROVIDER=openai-compatible
# AI_GATEWAY_PROVIDER_NAME=ollama-local
# AI_GATEWAY_BASE_URL=http://127.0.0.1:11434/v1
# AI_GATEWAY_MODEL=llama3.2:3b
#
# AI_GATEWAY_MODEL_FAST=llama3.2:3b       # ~98 tok/s, ~2.4GB VRAM, safe headroom
# AI_GATEWAY_MODEL_BALANCED=llama3.2:3b
# AI_GATEWAY_MODEL_QUALITY=gemma3:4b      # ~43 tok/s, ~3.9GB VRAM, better quality
# AI_GATEWAY_MAX_CONTEXT_CHARS=48000
# AI_GATEWAY_MAX_OUTPUT_TOKENS=4096
# AI_GATEWAY_DEFAULT_TOKEN_BUDGET=4096
# AI_GATEWAY_TIMEOUT_MS=30000
# AI_GATEWAY_INPUT_USD_PER_1K=0
# AI_GATEWAY_OUTPUT_USD_PER_1K=0
# AI_GATEWAY_MAX_REQUESTS_PER_MINUTE=30
# AI_GATEWAY_MAX_CONCURRENT_REQUESTS=2
#
# Option C — RunPod vLLM through a local SSH tunnel (on-demand GPU worker).
# Keep vLLM bound to 127.0.0.1 on the Pod and run
# infra/scripts/platform/runpod_vllm_tunnel.sh on the same machine as this API.
# The tunnel maps local port 18000 to the Pod's 127.0.0.1:8000.
# This local HTTP mode is for NODE_ENV != production. Production needs an
# authenticated HTTPS reverse proxy in front of vLLM; do not expose port 8000.
# AI_GATEWAY_PROVIDER=openai-compatible
# AI_GATEWAY_PROVIDER_NAME=runpod-vllm
# AI_GATEWAY_BASE_URL=http://127.0.0.1:18000/v1
# Generate model values from the selected catalog profile instead of copying
# provider payloads: `task llm:profile-env -- --profile compact --format shell`.
# AI_GATEWAY_MODEL=qwen3.8-27b-nvfp4
# AI_GATEWAY_MODEL_FAST=qwen3.8-27b-nvfp4
# AI_GATEWAY_MODEL_BALANCED=qwen3.8-27b-nvfp4
# AI_GATEWAY_MODEL_QUALITY=qwen3.8-27b-nvfp4
# AI_GATEWAY_MAX_CONTEXT_CHARS=12000
# AI_GATEWAY_MAX_OUTPUT_TOKENS=2048
# AI_GATEWAY_DEFAULT_TOKEN_BUDGET=4096
# AI_GATEWAY_TIMEOUT_MS=120000
# AI_GATEWAY_MAX_REQUESTS_PER_MINUTE=30
# AI_GATEWAY_MAX_CONCURRENT_REQUESTS=2
# HTTP bind policy: local development defaults to loopback. The production
# systemd unit sets NODE_ENV=production, which binds the API on 0.0.0.0 for
# its authenticated service boundary; set API_HOST explicitly when deploying
# behind a different ingress.
# API_HOST=127.0.0.1
# DASHBOARD_HOST=127.0.0.1
# Non-loopback dashboard binds fail closed unless this runtime-only bearer
# token is configured. Never commit a populated value.
# DASHBOARD_AUTH_TOKEN=
# AI_GATEWAY_INPUT_USD_PER_1K=0
# AI_GATEWAY_OUTPUT_USD_PER_1K=0

# Switchable LLM lab and hard budget guard (opt-in; fail-closed when enabled).
# The versioned model catalog lives at infra/platform/llm-lab-models.json.
# Use `task llm:profiles -- --json` and `task llm:profile-env -- --profile compact`.
# Set the monthly ceiling before reserving any GPU session. Values are USD.
# LLM_LAB_MONTHLY_BUDGET_USD=100
# LLM_LAB_HARD_STOP_RATIO=1
# LLM_LAB_DEFAULT_PROFILE=compact
# LLM_LAB_GPU_HOURLY_USD=0.69              # pass the current provider price
# LLM_LAB_MAX_SESSION_HOURS=12             # on-demand cap; no always-on Pod
# LLM_LAB_ALLOW_UNMETERED_API=false       # keep false for cost safety
# AI_STORAGE_MONTHLY_USD=0                 # fixed Network Volume/storage commitment
# LLM_LAB_LEDGER_PATH=data/generated/llm-lab/budget-events.jsonl
# Optional pilot estimates used by the read-only preflight (USD).
# LLM_LAB_PILOT_API_ESTIMATE_USD=0
# LLM_LAB_PILOT_STORAGE_ESTIMATE_USD=0

# Specialized GPU worker control plane. Keep disabled until the worker endpoint,
# privacy boundary, rate card, and owner are approved. This flag never starts a
# Pod; it only allows a high-volume job to pass the local queue policy.
# GPU_WORKER_RUNPOD_ENABLED=false
# GPU_WORKER_QUEUE_PATH=data/runtime/gpu-workers/jobs.json
#
# Local vLLM autostop: stop the process after 15 minutes idle or 4 hours max.
# Provider-level billing needs an operator-owned executable hook that calls
# the provider's Stop Pod/scale-to-zero operation; leave it empty until tested.
# VLLM_IDLE_TIMEOUT_SEC=900
# VLLM_MAX_RUNTIME_SEC=14400
# VLLM_IDLE_POLL_SEC=30
# VLLM_LAUNCHER=/workspace/llm-lab/llm-coder.sh
# The repository's fixed HTTPS RunPod hook is opt-in and requires all three:
# RUNPOD_AUTO_STOP_ENABLED=true
# RUNPOD_POD_ID=<pod-id>
# RUNPOD_API_KEY=
# VLLM_IDLE_STOP_HOOK=/absolute/path/to/infra/scripts/platform/runpod_stop_pod_hook.py

# Vercel (deployments status)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Multi-PaaS Control Plane (read-only health checks; never commit real values)
# Render: https://render.com/docs/api
RENDER_API_KEY=
# Railway: account/workspace token for the GraphQL API
RAILWAY_TOKEN=
RAILWAY_WORKSPACE_ID=
# RAILWAY_API_TOKEN=
# Fly.io: Machines API token plus the organization slug for app summary
FLY_API_TOKEN=
FLY_ORG_SLUG=
# FLY_TOKEN=
# Heroku Platform API token
HEROKU_TOKEN=
# HEROKU_API_KEY=

# Read-only cloud management credentials; values belong in Infisical.
# Database connection URLs are NOT management API tokens.
NEON_API_KEY=
# NEON_ORG_ID=
SUPABASE_ACCESS_TOKEN=
# Upstash management API uses EMAIL + API_KEY, not the Redis data-plane token.
UPSTASH_EMAIL=
UPSTASH_API_KEY=

# Cloudflare (workers status) — token already defined above
CLOUDFLARE_ACCOUNT_ID=

# GitHub (CI/CD status)
GITHUB_PERSONAL_ACCESS_TOKEN=
# Legacy alias accepted by older scripts:
# GITHUB_TOKEN=
GITHUB_REPOS=owner/repo1,owner/repo2

# Trading Bot (Docker container health)
TRADING_BOT_CONTAINERS=container-name-1,container-name-2

# LINE Notify
LINE_CHANNEL_TOKEN=your-line-notify-token

# LINE Official Account Messaging API (keep values in the secret provider)
LINE_SOLO_EMPIRE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_SOLO_EMPIRE_WEBHOOK_SECRET=your-line-channel-secret
# Public HTTPS URL ending in /api/webhook/line
LINE_SOLO_EMPIRE_WEBHOOK_URL=https://your-domain.example/api/webhook/line

# Discord Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook-url

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Solo Empire Bot <your-email@gmail.com>
EMAIL_TO=your-email@gmail.com

# Preferred task-digest delivery: Gmail API OAuth with send-only scope.
# Keep the refresh token in Infisical/Vault; do not put it in this file.
# GOOGLE_GMAIL_SEND_REFRESH_TOKEN=<gmail.send-only-refresh-token>
# Optional separate OAuth client; otherwise the shared Google client is reused.
# GOOGLE_GMAIL_SEND_CLIENT_ID=<oauth-client-id>
# GOOGLE_GMAIL_SEND_CLIENT_SECRET=<oauth-client-secret>
# TASK_DIGEST_TO=your-email@gmail.com

# Search Console API (separate from Gmail/Calendar). Request with:
# python3 infra/scripts/utils/get_google_refresh_token.py --search-console --store-infisical
# GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=<webmasters.readonly-refresh-token>

# Ahrefs API v3 (Site Audit). There is no username/password CLI login.
# Create a key as workspace owner/admin: Account settings → API keys.
# Store it in Infisical /ahrefs. GET /v3/site-audit/projects does not consume units.
# AHREFS_API_KEY=<ahrefs-api-v3-key>

# Telegram Notification Bots (3 domain-specific bots)
TELEGRAM_TRADING_BOT_TOKEN=your-trading-bot-token
TELEGRAM_NOTI_BOT_TOKEN=your-noti-bot-token
TELEGRAM_NOTI_CHAT_ID=your-chat-id
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Telegram user-account channel reader (Telethon; no bot is added to channels)
# Create these at https://my.telegram.org/apps. Keep the API hash private.
# TELEGRAM_API_ID=your-telegram-api-id
# TELEGRAM_API_HASH=your-telegram-api-hash

# Strava and Binance TH are intentionally paused. Do not add their credentials
# to the active runtime until these integrations are explicitly re-enabled.
# BookFinance Futures Demo credentials belong in Infisical `/trading` and must
# be injected only into the nested BookFinance strategy runtime. Never use a
# mainnet key for the testnet-only futures engine.
# BINANCE_FUTURES_API_KEY=<Infisical /trading>
# BINANCE_FUTURES_API_SECRET=<Infisical /trading>

# ─── Task Sync — Personal Sources ─────────────────────────────────────────────
# Todoist (personal tasks)
TODOIST_API_TOKEN=your-todoist-api-token

# Notion (personal tasks — database ID from your Notion tasks database)
NOTION_TASKS_DB_ID=your-notion-database-id

# Jira (personal tasks — optional, uses the reviewed MCP gateway)
# JIRA_DOMAIN=your-domain.atlassian.net
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=your-jira-api-token
